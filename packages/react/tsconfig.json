{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // tsup 8.5 injects a deprecated `baseUrl` into its declaration build;
    // this file sets no `baseUrl` itself. Remove once the build moves off tsup.
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": "..",
    "paths": {
      "@vixeq/core": ["../core/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
