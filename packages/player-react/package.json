{
  "name": "@vixeq/player-react",
  "version": "1.0.0-rc.1",
  "type": "module",
  "description": "Embeddable React sequence player GUI for Vixeq projects.",
  "license": "MIT",
  "homepage": "https://github.com/kramhash/vixeq#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kramhash/vixeq.git",
    "directory": "packages/player-react"
  },
  "bugs": {
    "url": "https://github.com/kramhash/vixeq/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/styles.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "sequencer",
    "step-sequencer",
    "react",
    "player",
    "daw"
  ],
  "peerDependencies": {
    "@vixeq/core": "workspace:^",
    "@vixeq/react": "workspace:^",
    "react": ">=18.0.0 <20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --sourcemap && cp src/styles.css dist/styles.css",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "api:check": "api-extractor run --verbose",
    "api:update": "api-extractor run --local --verbose"
  },
  "devDependencies": {
    "@vixeq/core": "workspace:*",
    "@vixeq/react": "workspace:*",
    "@types/react": "^19.1.8",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3"
  }
}
